{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ordo",
  "version": "1.0.0-beta",
  "identifier": "com.ordo.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Ordo — Fichas de Ordem Paranormal RPG",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/MigueXYZ/fichas_ordemparanormal/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  }
}
